#!/usr/bin/env bash
# 😈 app-wiz4rd — the Syntropia "pick your favorite apps" installer.
#
# The UI is a full-width fzf picker (with a numbered-list fallback when fzf is
# not installed). This script drives it: resolve the catalog, run the picker in
# a terminal, install the picks with yay, and (in --once mode) remember
# completion.
#
# Modes: (no args) run · --once · --resume · --config FILE · --install-autostart
#        · --remove-autostart
# Catalog: category|name|package|description[|aliases] (package may be an https://
# URL → a web-app launcher). Resolution: --config, ~/.config/syntropia/apps.list,
# /etc/syntropia/apps.list, apps.list next to the script (or /usr/share/app-wiz4rd).
#
# Offline behaviour: every choice is written to a pending queue BEFORE yay is
# asked to install anything, and only successful installs leave the queue. A
# run without network therefore loses nothing: the picks wait in
# ~/.config/syntropia/apps-wizard.pending, --once keeps firing until the queue is
# empty, and `--resume` installs whatever is still waiting. When the picker
# starts offline it offers nmtui-connect first, and every install is teed to
# ~/.local/state/app-wiz4rd/install.log so output survives a closed window.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Packaged layout (AUR): the script lives in /usr/bin, assets in /usr/share.
PKG_DIR="/usr/share/app-wiz4rd"
# Syntropia-shipped local helpers (e.g. syntropia-ssh-setup), not pacman/AUR packages.
HELPER_BIN_DIR="${SYNTROPIA_BIN_DIR:-/usr/local/bin}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
AUTOSTART_DIR="$CONFIG_HOME/autostart"
DONE_MARKER="$CONFIG_HOME/syntropia/apps-wizard.done"
# Choices that still need installing. Its presence is what makes a completed
# wizard run again — see the --once gate at the bottom.
PENDING_FILE="$CONFIG_HOME/syntropia/apps-wizard.pending"
# Install output + run traces. The autostart path has no console when the
# terminal relaunch fails, and a silent wizard is indistinguishable from one
# that never ran — so both are always recorded somewhere the user can read.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/app-wiz4rd"
INSTALL_LOG="$STATE_DIR/install.log"
BUNDLED_CATALOG="$SCRIPT_DIR/apps.list"
[[ -f "$BUNDLED_CATALOG" ]] || BUNDLED_CATALOG="$PKG_DIR/apps.list"
DESKTOP_TEMPLATE="$SCRIPT_DIR/syntropia-apps.desktop"
[[ -f "$DESKTOP_TEMPLATE" ]] || DESKTOP_TEMPLATE="$PKG_DIR/syntropia-apps.desktop"

BANNER="$(cat <<'BANNER_EOF'
   _______  ___   ____________  ____  ____  _______
  / ___/\ \/ / | / /_  __/ __ \/ __ \/ __ \/  _/   |
  \__ \  \  /  |/ / / / / /_/ / / / / /_/ // // /| |
 ___/ /  / / /|  / / / / _, _/ /_/ / ____// // ___ |
/____/  /_/_/ |_/ /_/ /_/ |_|\____/_/   /___/_/  |_|
BANNER_EOF
)"

MODE="interactive"
CATALOG=""

die() { echo "😈 error: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

log() {
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$INSTALL_LOG" 2>/dev/null || true
}

# Desktop notification for the paths that have no terminal to print to.
notify() {
    if have notify-send; then
        notify-send --app-name="Syntropia" "Syntropia apps" "$1" >/dev/null 2>&1 || true
    fi
}

# Cheap reachability probe. ICMP first (no curl dependency on a fresh install),
# DNS as the fallback for networks that drop ping.
is_online() {
    if have ping && ping -c1 -W2 -q 1.1.1.1 >/dev/null 2>&1; then
        return 0
    fi
    have getent && getent hosts archlinux.org >/dev/null 2>&1
}

mark_done() {
    mkdir -p "$(dirname "$DONE_MARKER")"
    touch "$DONE_MARKER"
}

# --- pending queue --------------------------------------------------------

pending_packages() {
    [[ -f "$PENDING_FILE" ]] || return 0
    awk 'NF && !seen[$0]++' "$PENDING_FILE"
}

pending_count() {
    pending_packages | wc -l | tr -d '[:space:]'
}

# queue_pending <package|url>...  — union with what is already queued, order
# preserved. This runs BEFORE any install attempt: if yay fails, the box loses
# power, or the network is down, the choice is already on disk.
queue_pending() {
    [[ $# -gt 0 ]] || return 0
    mkdir -p "$(dirname "$PENDING_FILE")"
    {
        pending_packages
        printf '%s\n' "$@"
    } | awk 'NF && !seen[$0]++' >"$PENDING_FILE.tmp"
    mv "$PENDING_FILE.tmp" "$PENDING_FILE"
}

# clear_pending <package|url>... — drop the entries that really installed.
clear_pending() {
    [[ $# -gt 0 ]] || return 0
    [[ -f "$PENDING_FILE" ]] || return 0
    local -a keep=()
    local pkg entry handled
    while IFS= read -r pkg; do
        [[ -n "$pkg" ]] || continue
        handled=0
        for entry in "$@"; do
            if [[ "$pkg" == "$entry" ]]; then
                handled=1
                break
            fi
        done
        if [[ "$handled" -eq 0 ]]; then
            keep+=("$pkg")
        fi
    done < <(pending_packages)
    if [[ ${#keep[@]} -eq 0 ]]; then
        rm -f "$PENDING_FILE"
    else
        printf '%s\n' "${keep[@]}" >"$PENDING_FILE"
    fi
}

# Cancelled / nothing selected — don't mark done, so it can run again later.
skip_note() {
    echo "😈 Skipped — you can pick apps any time with:"
    echo "  $0"
    if [[ "$MODE" == "once" && -t 0 ]]; then
        echo
        echo "Press Enter to close this window."
        read -r _ || true
    fi
}

# How to finish the job when yay could not.
pending_note() {
    local count
    count="$(pending_count)"
    [[ "$count" == "0" ]] && return 0
    echo
    echo "😈 ${count} app(s) are saved and waiting: $PENDING_FILE"
    if is_online; then
        echo "   Finish them with:  $0 --resume"
    else
        echo "   You are offline. Connect, then either log in again or run:"
        echo "     $0 --resume"
    fi
    if [[ "$MODE" == "once" && -t 0 ]]; then
        echo
        echo "Press Enter to close this window."
        read -r _ || true
    fi
}

# Offer a way online before the picker. The first boot is often offline (Wi-Fi
# not joined yet); without this the user picks apps they cannot install and
# only sees the queue message afterwards.
connectivity_prompt() {
    local attempt answer
    [[ -t 0 ]] || return 0

    for attempt in 1 2 3; do
        is_online && return 0
        echo "😈 No internet connection."
        echo "   [1] Connect now (NetworkManager text UI)"
        echo "   [2] Continue — picks are saved and installed once you are online"
        printf '   Choose [1-2] (default: 1): '
        IFS= read -r answer || return 0
        case "${answer:-1}" in
            1)
                if have nmtui-connect; then
                    nmtui-connect || true
                elif have nmtui; then
                    nmtui || true
                else
                    echo "   nmtui is not installed — connect with nmcli or Ethernet, then re-run."
                    return 0
                fi
                ;;
            *) return 0 ;;
        esac
    done
    return 0
}

resolve_catalog() {
    [[ -n "$CATALOG" ]] && { [[ -f "$CATALOG" ]] || die "catalog not found: $CATALOG"; echo "$CATALOG"; return; }
    local user_catalog="$CONFIG_HOME/syntropia/apps.list"
    [[ -f "$user_catalog" ]] && { echo "$user_catalog"; return; }
    [[ -f /etc/syntropia/apps.list ]] && { echo "/etc/syntropia/apps.list"; return; }
    echo "$BUNDLED_CATALOG"
}

# The installed system is Plasma (konsole) or Hyprland (alacritty/kitty), but
# the list covers the terminals a user may have installed and the freedesktop
# launcher, which knows the session's preferred terminal.
find_terminal() {
    [[ -n "${TERMINAL:-}" ]] && have "$TERMINAL" && { echo "$TERMINAL"; return; }
    local t
    for t in kitty ghostty foot alacritty wezterm konsole \
        gnome-terminal kgx xfce4-terminal x-terminal-emulator xterm \
        xdg-terminal-exec; do
        have "$t" && { echo "$t"; return; }
    done
    return 1
}

launch_terminal() {
    local term="$1" inner="$2" arr
    case "$term" in
        konsole)        arr=(konsole --geometry 110x34 -e bash -c "$inner") ;;
        gnome-terminal) arr=(gnome-terminal -- bash -c "$inner") ;;
        kgx)            arr=(kgx -- bash -c "$inner") ;;
        xfce4-terminal) arr=(xfce4-terminal -x bash -c "$inner") ;;
        kitty)          arr=(kitty --override initial_window_width=110c --override initial_window_height=34c bash -c "$inner") ;;
        alacritty)      arr=(alacritty -o window.dimensions.columns=110 -o window.dimensions.lines=34 -e bash -c "$inner") ;;
        ghostty)        arr=(ghostty --window-width=110 --window-height=34 -e bash -c "$inner") ;;
        foot)           arr=(foot --window-size-chars=110x34 bash -c "$inner") ;;
        wezterm)        arr=(wezterm start -- bash -c "$inner") ;;
        xdg-terminal-exec) arr=(xdg-terminal-exec bash -c "$inner") ;;
        *)              [[ -n "${TERMINAL:-}" ]] || return 1
                        arr=("$term" -e bash -c "$inner") ;;
    esac
    nohup "${arr[@]}" >/dev/null 2>&1 &
}

# rows: display<TAB>package<TAB>description<TAB>category<TAB>aliases
rows() {
    local cat_file="${1:-$(resolve_catalog)}"
    local width
    width="$(tput cols 2>/dev/null || true)"
    [[ -n "$width" ]] || width="${COLUMNS:-100}"
    awk -F'|' -v width="$width" '
        BEGIN {
            # 10 (category) + 1 + 26 (package) + 1 = 38, plus the fzf pointer
            # and marker gutter and the rounded border: keep 6 columns of slack
            # so a full row never wraps.
            desc_w = width - 44 - 6
            if (desc_w < 16) desc_w = 16
            c["Syntropia"] = "\033[1;38;5;117m"
            c["Chat"]      = "\033[38;5;80m"
            c["Browser"]   = "\033[38;5;75m"
            c["DAW"]       = "\033[38;5;177m"
            c["Audio"]     = "\033[38;5;114m"
            c["AI"]        = "\033[38;5;221m"
            c["Terminal"]  = "\033[38;5;250m"
            c["CLI"]       = "\033[38;5;245m"
            c["Video"]     = "\033[38;5;203m"
            c["Graphics"]  = "\033[38;5;214m"
            c["Privacy"]   = "\033[38;5;141m"
            c["Wallet"]    = "\033[38;5;186m"
            c["Remote"]    = "\033[38;5;78m"
            reset          = "\033[0m"
        }
        NF >= 4 && $1 !~ /^[[:space:]]*#/ && $1 != "" {
            colour  = ($1 in c) ? c[$1] : "\033[38;5;245m"
            aliases = (NF >= 5) ? $5 : ""
            suffix  = (aliases != "") ? sprintf(" \033[2m(%s)\033[0m", aliases) : ""
            # The alias suffix is appended AFTER the description, so its visible
            # length (" (aliases)") comes out of the description budget, or the
            # row overruns the terminal and wraps.
            avail = desc_w
            if (aliases != "") {
                avail = desc_w - length(aliases) - 3
                if (avail < 12) avail = 12
            }
            desc = substr($4, 1, avail)
            printf "%s%-10s%s \033[1m%-26s\033[0m %s%s\t%s\t%s\t%s\t%s\n", \
                colour, $1, reset, $3, desc, suffix, $3, $4, $1, aliases
        }
    ' "$cat_file"
}

# Centre a block of text to the current terminal width.
centre() {
    local cols line pad
    cols="$(tput cols 2>/dev/null || true)"
    [[ -n "$cols" ]] || cols="${COLUMNS:-100}"
    while IFS= read -r line; do
        pad=$(( (cols - ${#line}) / 2 ))
        (( pad < 0 )) && pad=0
        printf '%*s%s\n' "$pad" '' "$line"
    done
}

picker() {
    local cat_file="${1:-$(resolve_catalog)}"
    if [[ -z "${SYNTROPIA_PICKER_NO_FZF:-}" ]] && command -v fzf >/dev/null 2>&1; then
        # {+} = the ticked rows only. Capturing it separately is the only way to
        # tell "ENTER with 3 apps ticked" from "ENTER with nothing ticked", where
        # fzf would otherwise hand back the row under the cursor and install it.
        # {+} = the ticked rows only; fzf otherwise hands back the row under
        # the cursor, so ENTER with nothing ticked would install it. A marker
        # file records that ENTER fired at all: if it is missing (stub fzf in
        # tests, or an fzf too old for execute-silent) we fall back to stdout.
        local ticked rc out
        ticked="$(mktemp)"
        while true; do
            : > "$ticked"
            rm -f "$ticked.go"
            out="$(rows "$cat_file" | fzf --multi --reverse --height=100% --no-sort --ansi \
                --border=rounded \
                --separator='─' --scrollbar='▐' --highlight-line \
                --info=inline-right \
                --color='bg+:#1b1f27,fg+:#ffffff,hl:#7aa2f7,hl+:#7aa2f7:bold,pointer:#7aa2f7,marker:#9ece6a,prompt:#bb9af7,header:#565f89,border:#3b4261,info:#565f89' \
                --delimiter='\t' --with-nth=1 \
                --pointer='▶' --marker='✓' \
                --bind 'space:toggle+down,tab:toggle+down' \
                --bind "enter:execute-silent(printf '%s\\n' {+} > $ticked; touch $ticked.go)+accept" \
                --header="$(printf '%s\n\n%s' "$(centre <<< "$BANNER")" "         SPACE tick   ·   ENTER install   ·   ESC cancel   ·   type to filter")" \
                --header-first \
                --no-preview)"
            rc=$?
            if (( rc != 0 )); then
                rm -f "$ticked" "$ticked.go"
                return 1
            fi
            if [[ -f "$ticked.go" ]]; then
                # Real fzf: only what was ticked counts.
                if [[ -s "$ticked" ]]; then
                    cat "$ticked"
                    rm -f "$ticked" "$ticked.go"
                    return 0
                fi
                echo
                echo "😈 nothing ticked — SPACE to tick, ENTER to install, ESC to cancel."
                sleep 1
                continue
            fi
            # No marker: fzf did not run our ENTER binding — trust its stdout.
            if [[ -n "$out" ]]; then
                printf '%s\n' "$out"
                rm -f "$ticked"
                return 0
            fi
            rm -f "$ticked"
            return 1
        done
    fi
    echo "fzf not installed — numbered mode. Type numbers, e.g. 1 4 7" >&2
    printf '%s\n\n' "$BANNER" >&2
    local i=0 line pkg
    declare -A pick_map=()
    while IFS=$'\t' read -r line pkg _; do
        i=$((i + 1))
        pick_map[$i]="$line"$'\t'"$pkg"
        printf '%3d  %s\n' "$i" "$line" >&2
    done < <(rows "$cat_file")
    echo >&2
    local -a chosen=() answer
    read -r -p "install (numbers, blank to cancel): " answer || true
    [[ -n "$answer" ]] || return 0
    for n in $answer; do
        [[ -n "${pick_map[$n]:-}" ]] && chosen+=("${pick_map[$n]}")
    done
    ((${#chosen[@]})) && printf '%s\n' "${chosen[@]}"
    return 0
}

create_web_launcher() {
    local name="$1" url="$2" slug launcher exec_line
    slug="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' '-' | sed 's/^-*//; s/-*$//')"
    launcher="${XDG_DATA_HOME:-$HOME/.local/share}/applications/syntropia-$slug.desktop"
    if have brave; then exec_line="brave --app=$url"
    elif have chromium; then exec_line="chromium --app=$url"
    elif have firefox; then exec_line="firefox --new-window $url"
    else exec_line="xdg-open $url"; fi
    mkdir -p "$(dirname "$launcher")"
    cat > "$launcher" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=$name (Web)
Comment=Web app: $url
Exec=$exec_line
Icon=applications-internet
Terminal=false
Categories=Network;
X-Syntropia-WebApp=true
EOF
    echo "  ✅ $name  →  $launcher"
}

# Map web-app URLs back to display names (the TUI prints package tags, which for
# web apps are the URLs).
load_web_names() {
    local cat_file row _ name pkg _rest
    cat_file="$(resolve_catalog)"
    declare -gA WEB_NAME=()
    [[ -f "$cat_file" ]] || return 0
    while IFS= read -r row || [[ -n "$row" ]]; do
        row="$(printf '%s' "$row" | sed -E 's/(^|[[:space:]])#.*/\1/')"
        [[ -z "${row//[[:space:]]/}" ]] && continue
        IFS='|' read -r _ name pkg _rest <<< "$row"
        if [[ "$pkg" == http* ]]; then
            WEB_NAME["$pkg"]="$name"
        fi
    done < "$cat_file"
}

# Install everything in the pending queue. Web apps only need a local launcher
# and Syntropia helpers live in $HELPER_BIN_DIR, so neither needs yay; native
# packages need yay and a working mirror.
# Returns non-zero when anything is still queued afterwards.
process_pending() {
    local -a queue=() native=() helpers=() web_urls=() web_names=()
    local pkg i helper_failed=0

    while IFS= read -r pkg; do queue+=("$pkg"); done < <(pending_packages)
    if [[ ${#queue[@]} -eq 0 ]]; then
        echo "Nothing queued — everything is already installed."
        return 0
    fi

    load_web_names
    for pkg in "${queue[@]}"; do
        if [[ "$pkg" == http* ]]; then
            web_urls+=("$pkg")
            web_names+=("${WEB_NAME[$pkg]:-$pkg}")
        elif [[ "$pkg" == syntropia-* && -x "$HELPER_BIN_DIR/$pkg" ]]; then
            helpers+=("$pkg")
        else
            native+=("$pkg")
        fi
    done

    if [[ ${#web_urls[@]} -gt 0 ]]; then
        echo "Creating web app launchers:"
        for i in "${!web_urls[@]}"; do
            create_web_launcher "${web_names[$i]}" "${web_urls[$i]}"
        done
        clear_pending "${web_urls[@]}"
    fi

    if [[ ${#helpers[@]} -gt 0 ]]; then
        echo "Running Syntropia helpers: ${helpers[*]}"
        echo "   (the output is also saved to $INSTALL_LOG)"
        echo
        for pkg in "${helpers[@]}"; do
            log "helper $HELPER_BIN_DIR/$pkg"
            if "$HELPER_BIN_DIR/$pkg" 2>&1 | tee -a "$INSTALL_LOG"; then
                clear_pending "$pkg"
            else
                echo
                echo "😈 $pkg could not complete — stays queued, so nothing is lost."
                helper_failed=1
            fi
        done
    fi

    if [[ ${#native[@]} -gt 0 ]]; then
        if ! have yay; then
            if ! is_online; then
                echo "😈 yay is not installed and there is no internet — nothing was installed."
                pending_note
                return 1
            fi
            echo "Installing yay (sudo will ask for your password)..."
            if ! sudo pacman -S --noconfirm yay; then
                echo "😈 could not install yay."
                pending_note
                return 1
            fi
        fi

        echo "Installing packages: ${native[*]}"
        echo "   (the output is also saved to $INSTALL_LOG)"
        echo
        log "yay -S --noconfirm --needed ${native[*]}"
        if yay -S --noconfirm --needed "${native[@]}" 2>&1 | tee -a "$INSTALL_LOG"; then
            clear_pending "${native[@]}"
        else
            # One broken package (stale mirror 404, bad signature, dead AUR
            # pkgbuild) aborts the whole pacman transaction, so the batch retry
            # alone would loop forever on the same failure. Fall back to
            # per-package installs: each pick gets its own transaction, so a
            # single bad one cannot starve the rest of the queue.
            echo
            echo "😈 batch install failed — retrying packages one at a time..."
            local -a failed_pkgs=()
            local pkg
            for pkg in "${native[@]}"; do
                pacman -Q "$pkg" >/dev/null 2>&1 && continue
                log "yay -S --noconfirm --needed $pkg (solo retry)"
                if yay -S --noconfirm --needed "$pkg" 2>&1 | tee -a "$INSTALL_LOG"; then
                    clear_pending "$pkg"
                else
                    failed_pkgs+=("$pkg")
                fi
            done
            # Unqueue whatever landed during the batch attempt before the abort.
            for pkg in "${native[@]}"; do
                if pacman -Q "$pkg" >/dev/null 2>&1; then
                    clear_pending "$pkg"
                fi
            done
            if ((${#failed_pkgs[@]})); then
                echo
                echo "😈 could not install: ${failed_pkgs[*]}"
                echo "   (they stay queued — the wizard retries on next login;"
                echo "    a stale mirror is the usual cause: run: sudo cachyos-rate-mirrors)"
                pending_note
                return 1
            fi
        fi
    fi

    if (( helper_failed )); then
        pending_note
        return 1
    fi

    return 0
}

run_dialog() {
    local cat_file selection pkg rc
    local -a selected=()

    cat_file="$(resolve_catalog)"
    [[ -f "$cat_file" ]] || die "no catalog found: $cat_file"

    # Autostart launches us detached (no TTY) — relaunch inside a terminal;
    # the inner run then installs inline in that same terminal.
    if [[ ! -t 0 && -z "${SYNTROPIA_PICKER_NO_FZF:-}" ]]; then
        local -a relaunch=("$0")
        [[ "$MODE" == "once" ]] && relaunch+=(--once)
        [[ "$MODE" == "resume" ]] && relaunch+=(--resume)
        [[ -n "$CATALOG" ]] && relaunch+=(--config "$CATALOG")
        local term q
        if ! term="$(find_terminal)"; then
            log "error: no terminal emulator found"
            notify "No terminal found — run app-wiz4rd from a terminal to pick apps."
            die "no terminal emulator found — run in a terminal instead: $0 (log: $INSTALL_LOG)"
        fi
        q="$(printf '%q ' "${relaunch[@]}")"
        # Keep the window open when the inner run fails: a terminal that
        # vanishes on error is exactly how "nothing happened" reports start.
        q+="|| { echo; echo 'app-wiz4rd failed — log: $INSTALL_LOG'; read -r _; }"
        log "relaunching inside $term (no tty on stdin)"
        launch_terminal "$term" "$q"
        exit 0
    fi

    log "run mode=$MODE catalog=$cat_file"

    # No connection? Give the user a way to get one before the picker.
    connectivity_prompt

    # Anything queued from an earlier (offline) run is retried first: this is
    # what makes the first-boot prompt, the app menu and --resume all capable of
    # finishing the job once a connection exists.
    local queued
    queued="$(pending_count)"
    if [[ "$queued" != "0" ]]; then
        echo "😈 ${queued} app(s) are still waiting from a previous run."
        if is_online; then
            echo "   Installing them now…"
            echo
            process_pending || true
            echo
        else
            echo "   You are offline — they stay queued until you are connected."
            echo
        fi
    fi
    if ! is_online; then
        echo "😈 No internet right now. You can still pick apps:"
        echo "   they are saved to a queue and installed next time you are online."
        echo
    fi

    rc=0
    selection="$(picker "$cat_file")" || rc=$?
    if [[ $rc -ne 0 ]]; then
        skip_note
        exit 0
    fi
    while IFS=$'\t' read -r _ pkg _; do
        [[ -n "${pkg:-}" ]] && selected+=("$pkg")
    done <<< "$selection"

    if [[ ${#selected[@]} -eq 0 ]]; then
        echo "😈 Nothing selected — nothing installed."
        skip_note
        exit 0
    fi

    # Confirm before anything touches the system. Skipped when there is no tty
    # (autostart relaunch) or when SYNTROPIA_WIZARD_ASSUME_YES is set, which the
    # test harness uses to drive the picker without answering prompts.
    if [[ -t 0 && -z "${SYNTROPIA_WIZARD_ASSUME_YES:-}" ]]; then
        local row
        echo
        echo "😈 Ready to install ${#selected[@]} app(s):"
        for row in "${selected[@]}"; do
            printf '   %s\n' "$(printf '%s' "$row" | cut -f1 | cut -c1-100)"
        done
        echo
        local reply
        read -r -p "Proceed? [Y/n] " reply || reply=""
        case "${reply:-Y}" in
            [Yy]*|"") ;;
            *)
                echo "Cancelled — nothing installed."
                exit 0
                ;;
        esac
        echo
    fi

    # Durable first: the queue is the record of intent, yay is just the worker.
    queue_pending "${selected[@]}"
    echo "Queued ${#selected[@]} choice(s)."
    log "picked: ${selected[*]}"
    echo

    if process_pending; then
        echo
        echo "✅ Done."
        if [[ "$MODE" == "once" ]]; then
            mark_done
            echo "Press Enter to close this window."
            read -r _ || true
        fi
    fi
}

# --resume: install whatever is queued, no picker. This is the re-runnable path
# the first-boot prompt points at once a connection exists.
run_resume() {
    if [[ "$(pending_count)" == "0" ]]; then
        echo "Nothing pending — all picked apps are installed."
        return 0
    fi
    echo "Resuming the install of $(pending_count) queued app(s)..."
    echo
    if process_pending; then
        echo
        echo "✅ Done — the queue is empty."
        mark_done
    fi
}

install_autostart() {
    [[ -f "$DESKTOP_TEMPLATE" ]] || die "desktop template not found: $DESKTOP_TEMPLATE"
    mkdir -p "$AUTOSTART_DIR"
    local script_path
    script_path="$SCRIPT_DIR/$(basename "$0")"
    sed "s|@SCRIPT@|$script_path|" "$DESKTOP_TEMPLATE" > "$AUTOSTART_DIR/syntropia-apps.desktop"
    echo "Autostart entry installed: $AUTOSTART_DIR/syntropia-apps.desktop"
    echo "It will run once on your next login (and again if apps are still pending)."
}

remove_autostart() {
    rm -f "$AUTOSTART_DIR/syntropia-apps.desktop"
    echo "Autostart entry removed."
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --once) MODE="once"; shift ;;
        --resume) MODE="resume"; shift ;;
        --config) [[ $# -ge 2 ]] || die "--config needs a file argument"; CATALOG="$2"; shift 2 ;;
        --install-autostart) MODE="install-autostart"; shift ;;
        --remove-autostart)  MODE="remove-autostart"; shift ;;
        -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "unknown option: $1 (try --help)" ;;
    esac
done

case "$MODE" in
    install-autostart) install_autostart ;;
    remove-autostart)  remove_autostart ;;
    resume)            run_resume ;;
    *)
        # Completed only counts when nothing is still queued: a run that chose
        # apps offline leaves the queue behind, so the next login retries it.
        if [[ "$MODE" == "once" && -f "$DONE_MARKER" && "$(pending_count)" == "0" ]]; then
            echo "Already completed — remove $DONE_MARKER to run again."
            exit 0
        fi
        run_dialog
        ;;
esac
